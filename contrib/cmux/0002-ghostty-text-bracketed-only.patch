+    export fn ghostty_surface_bracketed_paste_active(surface: *Surface) bool {
+        return surface.core_surface.bracketedPasteActive();
+    }
+
+    /// cmux fork: bracketed-paste-only text (see
+    /// Surface.bracketedPasteOnlyCallback). false = nothing was written.
+    export fn ghostty_surface_text_bracketed_only(
+        surface: *Surface,
+        ptr: [*]const u8,
+        len: usize,
+    ) bool {
+        return surface.core_surface.bracketedPasteOnlyCallback(ptr[0..len]) catch |err| {
+            log.err("error in bracketed-only paste err={}", .{err});
+            return false;
+        };
+    }
