+/// cmux fork (`surface.exact_input` probe): whether a paste right now would
+/// be framed (DECSET 2004 active). Read-only.
+pub fn bracketedPasteActive(self: *Surface) bool {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    return input.paste.Options.fromTerminal(&self.io.terminal).bracketed;
+}
+
+/// cmux fork (`surface.exact_input`): paste `data` ONLY as a bracketed paste.
+/// Returns false and writes nothing when the terminal has not enabled
+/// bracketed paste (DECSET 2004), when the data carries any ESC (it could
+/// close the fence early), or when the child already exited. Unlike
+/// textCallback it never sends an unframed paste, so interior newlines can
+/// never submit a line on their own.
+pub fn bracketedPasteOnlyCallback(self: *Surface, data: []const u8) !bool {
+    if (data.len == 0) return false;
+    if (std.mem.indexOfScalar(u8, data, 0x1B) != null) return false;
+    if (self.child_exited) return false;
+
+    const encode_opts: input.paste.Options = encode_opts: {
+        self.renderer_state.mutex.lockUncancelable(global.io());
+        defer self.renderer_state.mutex.unlock(global.io());
+        const opts: input.paste.Options = .fromTerminal(&self.io.terminal);
+        if (!opts.bracketed) return false;
+        self.scrollToBottom() catch |err| {
+            log.warn("error scrolling to bottom err={}", .{err});
+        };
+        break :encode_opts opts;
+    };
+
+    // Fence, payload and closing fence cross the IO mailbox as one message
+    // (same as completeClipboardPaste).
+    self.queueIo(.{ .write_alloc = .{
+        .alloc = self.alloc,
+        .data = try input.paste.encodeAlloc(self.alloc, data, encode_opts),
+    } }, .unlocked);
+    return true;
+}
+
