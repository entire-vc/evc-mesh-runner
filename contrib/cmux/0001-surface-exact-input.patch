+    /// Outcome of a live-runtime-only write (`surface.exact_input`).
+    public enum ExactInputWriteResult: Equatable, Sendable {
+        /// Written to the current live runtime.
+        case sent
+        /// No live runtime; nothing was queued and no runtime was started.
+        case notLive
+        /// A clipboard read would defer the input; nothing was queued.
+        case deferred
+        /// The runtime's child process already exited.
+        case processExited
+        /// The key name is not supported.
+        case unknownKey
+        /// The terminal has not enabled bracketed paste (DECSET 2004) or the
+        /// text carries ESC; nothing was written (an unframed paste could
+        /// submit at an interior newline).
+        case notBracketed
+    }
+
+    /// Read-only: whether the CURRENT live runtime would frame a paste right
+    /// now (bracketed paste, DECSET 2004). false when there is no live runtime.
+    @MainActor
+    public func liveRuntimeAcceptsBracketedPaste() -> Bool {
+        guard surface != nil,
+              let liveSurface = liveSurfaceForSocketWrite(reason: "socket.exactInputProbe") else { return false }
+        return ghostty_surface_bracketed_paste_active(liveSurface)
+    }
+
+    /// Writes text to the CURRENT live runtime ONLY as a bracketed paste, or
+    /// refuses. Unlike ``sendTextResult(_:)`` it never queues on a cold
+    /// surface, never requests a runtime start, never defers behind a
+    /// clipboard read and never sends an unframed paste.
+    @MainActor
+    public func writeTextToLiveRuntimeOnly(_ text: String) -> ExactInputWriteResult {
+        guard let data = text.data(using: .utf8), !data.isEmpty else { return .notLive }
+        guard surface != nil else { return .notLive }
+        guard !surfaceView.hasRuntimeInputDeferral() else { return .deferred }
+        guard let liveSurface = liveSurfaceForSocketWrite(reason: "socket.exactInput") else { return .notLive }
+        guard !ghostty_surface_process_exited(liveSurface) else { return .processExited }
+        TerminalPredictionCenter.shared.sentUntrackedInput(surfaceID: id)
+        let framed = data.withUnsafeBytes { rawBuffer -> Bool in
+            guard let baseAddress = rawBuffer.baseAddress?.assumingMemoryBound(to: CChar.self) else { return false }
+            return ghostty_surface_text_bracketed_only(liveSurface, baseAddress, UInt(rawBuffer.count))
+        }
+        guard framed else { return .notBracketed }
+        didReceiveExplicitInput()
+        didAcceptExplicitInput()
+        return .sent
+    }
+
+    /// Sends one named key to the CURRENT live runtime or refuses (see
+    /// ``writeTextToLiveRuntimeOnly(_:)``).
+    @MainActor
+    public func sendNamedKeyToLiveRuntimeOnly(_ keyName: String) -> ExactInputWriteResult {
+        guard let event = pendingKeyEvent(for: keyName) else { return .unknownKey }
+        guard surface != nil else { return .notLive }
+        guard !surfaceView.hasRuntimeInputDeferral() else { return .deferred }
+        guard let liveSurface = liveSurfaceForSocketWrite(reason: "socket.exactInputKey") else { return .notLive }
+        guard !ghostty_surface_process_exited(liveSurface) else { return .processExited }
+        didReceiveExplicitInput()
+        sendKeyEvent(surface: liveSurface, keycode: event.keycode, mods: event.mods)
+        didAcceptExplicitInput()
+        return .sent
+    }
+
