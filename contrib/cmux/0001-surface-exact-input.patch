@@ -0,0 +1,114 @@
+import Foundation
+
+/// `surface.exact_input` (contract `cmux.exact_input.v1`): input that reaches
+/// exactly one EXISTING native process in one terminal surface, or nothing.
+///
+/// Additive and opt-in. Unlike `surface.send_text`/`send_key`/`terminal.paste`
+/// it never resumes a hibernated agent, never queues on a cold surface, never
+/// requests a runtime start, never defers behind a clipboard read and never
+/// falls back to the focused/selected surface. All checks and the write run in
+/// one main-actor turn. Every refusal is a typed `exact_*` error with zero input.
+public struct ControlSurfaceExactInputRequest: Sendable, Equatable {
+    public enum Mode: String, Sendable { case probe, stage, submit }
+    public let mode: Mode
+    public let workspaceID: UUID
+    public let surfaceID: UUID
+    public let expectedTTY: String
+    public let expectedPID: Int32
+    public let expectedPIDStart: Int64
+    /// stage: the text (bracketed paste, no Enter).
+    public let text: String?
+    /// submit: the named key (only `return` in v1).
+    public let submitKey: String?
+    /// submit: the runtime generation the stage answered with.
+    public let expectedRuntimeGeneration: UInt64?
+}
+
+public enum ControlSurfaceExactInputResolution: Sendable, Equatable {
+    /// Proved (probe) or written (stage/submit) on exactly the pinned target.
+    case done(tty: String, runtimeGeneration: UInt64)
+    /// Typed refusal; nothing was written, resumed, queued or started.
+    case refused(code: String)
+    /// The app conformance does not implement the contract.
+    case unsupported
+}
+
+extension ControlCommandCoordinator {
+    static let exactInputContract = "cmux.exact_input.v1"
+
+    /// Strict parse: literal UUIDs only (no `kind:N` refs, no focus fallback),
+    /// `no_resume`/`no_queue` must be literal `true`.
+    func parseExactInput(_ params: [String: JSONValue]) -> ControlSurfaceExactInputRequest? {
+        func literalUUID(_ key: String) -> UUID? {
+            guard case .string(let raw)? = params[key] else { return nil }
+            return UUID(uuidString: raw)
+        }
+        func literalInt(_ key: String) -> Int64? {
+            guard case .int(let value)? = params[key] else { return nil }
+            return value
+        }
+        guard case .string(Self.exactInputContract)? = params["contract"],
+              case .bool(true)? = params["no_resume"],
+              case .bool(true)? = params["no_queue"],
+              case .string(let rawMode)? = params["mode"],
+              let mode = ControlSurfaceExactInputRequest.Mode(rawValue: rawMode),
+              let workspaceID = literalUUID("workspace_id"),
+              let surfaceID = literalUUID("surface_id"),
+              case .string(let tty)? = params["expected_tty"], tty.hasPrefix("/dev/ttys"),
+              let pid = literalInt("expected_pid"), pid > 0, pid <= Int64(Int32.max),
+              let start = literalInt("expected_pid_start"), start > 0
+        else { return nil }
+        var text: String?
+        var submitKey: String?
+        var generation: UInt64?
+        switch mode {
+        case .probe:
+            break
+        case .stage:
+            guard case .string(let value)? = params["text"], !value.isEmpty,
+                  !value.contains("\u{1B}"), !value.contains("\u{0}") else { return nil }
+            text = value
+        case .submit:
+            guard case .string("return")? = params["submit_key"],
+                  case .string(let raw)? = params["expected_runtime_generation"],
+                  let parsed = UInt64(raw) else { return nil }
+            submitKey = "return"
+            generation = parsed
+        }
+        return ControlSurfaceExactInputRequest(
+            mode: mode, workspaceID: workspaceID, surfaceID: surfaceID, expectedTTY: tty,
+            expectedPID: Int32(pid), expectedPIDStart: start, text: text, submitKey: submitKey,
+            expectedRuntimeGeneration: generation
+        )
+    }
+
+    /// `surface.exact_input` — main-actor verb (default execution policy).
+    func surfaceExactInput(_ params: [String: JSONValue]) -> ControlCallResult {
+        guard let request = parseExactInput(params) else {
+            return .err(code: "exact_invalid_params", message: "Invalid exact_input request", data: nil)
+        }
+        guard let context else {
+            return .err(code: "unavailable", message: "TabManager not available", data: nil)
+        }
+        switch context.controlSurfaceExactInput(request) {
+        case .unsupported:
+            return .err(code: "method_not_found", message: "Unknown method", data: nil)
+        case .refused(let code):
+            return .err(code: "exact_" + code, message: "exact_input refused", data: nil)
+        case let .done(tty, generation):
+            return .ok(.object([
+                "contract": .string(Self.exactInputContract),
+                "mode": .string(request.mode.rawValue),
+                "delivery": .string(request.mode == .probe ? "probed" : "received"),
+                "workspace_id": .string(request.workspaceID.uuidString),
+                "surface_id": .string(request.surfaceID.uuidString),
+                "tty": .string(tty),
+                "producer_pid": .int(Int64(request.expectedPID)),
+                "producer_start": .int(request.expectedPIDStart),
+                "runtime_generation": .string(String(generation)),
+                "resumed": .bool(false),
+                "queued": .bool(false),
+            ]))
+        }
+    }
+}
