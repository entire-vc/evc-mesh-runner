diff --git a/Sources/TerminalController+ControlSurfaceExactInput.swift b/Sources/TerminalController+ControlSurfaceExactInput.swift
new file mode 100644
index 00000000000..23674022c14
--- /dev/null
+++ b/Sources/TerminalController+ControlSurfaceExactInput.swift
@@ -0,0 +1,117 @@
+import CmuxControlSocket
+import CmuxTerminal
+import Darwin
+import Foundation
+
+/// App witness of `surface.exact_input` (contract `cmux.exact_input.v1`).
+///
+/// Everything below runs in ONE main-actor call: no check can be invalidated by
+/// a surface replacement, hibernation or runtime restart between the proof and
+/// the write. The write goes to the raw canonical `TerminalSurface` through the
+/// live-only writers (the stage only as a bracketed paste: ghostty
+/// `ghostty_surface_text_bracketed_only`, so an interior newline can never
+/// submit), never through `TerminalPanel`'s explicit-input wrappers
+/// (those resume hibernated agents) and never through the queueing
+/// `sendTextResult` paths. No focus, selection, index, remote-tmux projection or
+/// caller-context fallback is consulted: the workspace and surface are the
+/// literal UUIDs of the request.
+extension TerminalController {
+    func controlSurfaceExactInput(
+        _ request: ControlSurfaceExactInputRequest
+    ) -> ControlSurfaceExactInputResolution {
+        guard let tabManager = AppDelegate.shared?.tabManagerFor(tabId: request.workspaceID),
+              let workspace = tabManager.tabs.first(where: { $0.id == request.workspaceID }),
+              let panel = workspace.panels[request.surfaceID] as? TerminalPanel,
+              panel.id == request.surfaceID else {
+            return .refused(code: "target_missing")
+        }
+        // Panel owner and live registry owner must be the same object: a
+        // registry-rebound surface is a replacement in progress.
+        guard let canonical = GhosttyApp.terminalSurfaceRegistry.terminalSurface(id: request.surfaceID),
+              canonical.tabId == request.workspaceID,
+              canonical === panel.surface else {
+            return .refused(code: "target_replacing")
+        }
+        guard !panel.isAgentHibernated else {
+            return .refused(code: "target_hibernated")       // never resumed
+        }
+        guard canonical.surface != nil else {
+            return .refused(code: "surface_unavailable")     // never queued, never started
+        }
+        guard workspace.hasCurrentRuntimeReportedTTY(panelId: request.surfaceID, terminal: panel),
+              let surfaceDevice = workspace.surfaceTTYDevices[request.surfaceID] else {
+            return .refused(code: "tty_unreported")
+        }
+        guard CmuxTopProcessSnapshot.deviceIdentifier(forTTYName: request.expectedTTY) == surfaceDevice else {
+            return .refused(code: "tty_mismatch")
+        }
+        if let refusal = Self.exactInputProducerRefusal(
+            pid: request.expectedPID,
+            start: request.expectedPIDStart,
+            surfaceDevice: surfaceDevice
+        ) {
+            return .refused(code: refusal)
+        }
+        let generation = canonical.runtimeSurfaceGeneration
+        // probe and stage: the metadata block is multi-line, so it may only
+        // ever arrive framed; refuse up front instead of failing at the write.
+        if request.mode != .submit, !canonical.liveRuntimeAcceptsBracketedPaste() {
+            return .refused(code: "paste_unbracketed")
+        }
+        switch request.mode {
+        case .probe:
+            return .done(tty: request.expectedTTY, runtimeGeneration: generation)
+        case .stage:
+            guard let text = request.text else { return .refused(code: "invalid_params") }
+            return Self.exactInputResolution(
+                canonical.writeTextToLiveRuntimeOnly(text),
+                tty: request.expectedTTY,
+                generation: generation
+            )
+        case .submit:
+            guard request.expectedRuntimeGeneration == generation else {
+                return .refused(code: "generation_changed")
+            }
+            guard let key = request.submitKey else { return .refused(code: "invalid_params") }
+            return Self.exactInputResolution(
+                canonical.sendNamedKeyToLiveRuntimeOnly(key),
+                tty: request.expectedTTY,
+                generation: generation
+            )
+        }
+    }
+
+    /// The pinned native producer as the kernel sees it right now: alive, same
+    /// birth time, controlling terminal = the surface's tty, and the foreground
+    /// process group of that terminal.
+    nonisolated static func exactInputProducerRefusal(
+        pid: Int32,
+        start: Int64,
+        surfaceDevice: Int64
+    ) -> String? {
+        var info = proc_bsdinfo()
+        let expectedSize = MemoryLayout<proc_bsdinfo>.stride
+        guard proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, &info, Int32(expectedSize)) == expectedSize else {
+            return "producer_gone"
+        }
+        guard Int64(info.pbi_start_tvsec) == start else { return "producer_changed" }
+        guard Int64(info.e_tdev) == surfaceDevice else { return "producer_not_on_tty" }
+        guard info.e_tpgid > 0, Int(info.pbi_pgid) == Int(info.e_tpgid) else { return "producer_not_foreground" }
+        return nil
+    }
+
+    nonisolated static func exactInputResolution(
+        _ result: TerminalSurface.ExactInputWriteResult,
+        tty: String,
+        generation: UInt64
+    ) -> ControlSurfaceExactInputResolution {
+        switch result {
+        case .sent: return .done(tty: tty, runtimeGeneration: generation)
+        case .notLive: return .refused(code: "surface_unavailable")
+        case .deferred: return .refused(code: "queued_not_received")
+        case .processExited: return .refused(code: "producer_gone")
+        case .unknownKey: return .refused(code: "invalid_params")
+        case .notBracketed: return .refused(code: "paste_unbracketed")
+        }
+    }
+}
